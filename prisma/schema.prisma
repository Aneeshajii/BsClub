generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id                   Int      @id @default(autoincrement())
  registrationId       String   @unique // e.g. BSC0001
  name                 String
  phone                String
  gender               String?  // "Male" or "Female" (Optional now)
  venue                String?  // e.g. "Venue 1" or "Venue 2"
  email                String?
  age                  Int?
  registeredBefore     String?
  level                String?
  // Tournament Fields
  partnerName          String?
  partnerEmail         String?
  partnerAge           Int?
  partnerLevel         String?
  userPhotoUrl         String?
  partnerPhotoUrl      String?
  tournamentCategory   String? // e.g. "Men's Doubles", "Women's Doubles", "Mixed Doubles"
  playingMixedDoubles  Boolean @default(false)
  mixedPartnerName     String?
  mixedPartnerEmail    String?
  mixedPartnerAge      Int?
  mixedPartnerLevel    String?
  mixedPartnerPhotoUrl String?
  // Payment
  paymentScreenshotUrl String
  createdAt            DateTime @default(now())
}

model Settings {
  id                  Int     @id @default(1)
  maxMale             Int     @default(29)
  maxFemale           Int     @default(29)
  registrationMode    String  @default("GENDER") // "GENDER", "VENUE_AND_GENDER", "TOURNAMENT"
  venue1Name          String  @default("Khel Academy, Kazhakuttom (10:00 to 12:00)")
  venue1MaxMale       Int     @default(15)
  venue1MaxFemale     Int     @default(15)
  venue2Name          String  @default("Falcon Academy (10:30 to 12:30)")
  venue2MaxMale       Int     @default(15)
  venue2MaxFemale     Int     @default(15)
  mensDoublesMax      Int     @default(15)
  womensDoublesMax    Int     @default(15)
  mixedDoublesMax     Int     @default(15)
  registrationOpen    Boolean @default(true)
  qrCodeImageUrl      String  @default("")
  announcementTitle   String  @default("")
  announcementMessage String  @default("")
  announcementEnabled Boolean @default(false)
}
